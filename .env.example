# Copy to .env.local (git-ignored) for local runs; set the same values as EAS environment variables for store builds.

# RevenueCat public SDK keys (Project settings → API keys). Leave empty to run in demo mode.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Where weekly content is hosted. Defaults to this repo's GitHub Pages site.
# EXPO_PUBLIC_CONTENT_BASE_URL=https://lazyprogrammer9033.github.io/kidsstudyapp/

# Simulate purchases in a test build when no RevenueCat key is set. NEVER set for store builds.
# EXPO_PUBLIC_DEMO_PURCHASES=1
